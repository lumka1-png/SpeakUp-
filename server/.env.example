# Claude API key from https://platform.claude.com (keep it secret; never put it in the app).
# ANTHROPIC_API_KEY also works if SPEAKUP_CLAUDE_KEY is not set.
SPEAKUP_CLAUDE_KEY=
# Optional: compare quality and cost by switching models, for example claude-haiku-5-5.
CLAUDE_MODEL=claude-opus-5-5
# Token for the /admin/reports.csv download. Use a long random string.
ADMIN_TOKEN=
# Comma-separated web origins allowed to call the API (for the web app). Empty allows all.
ALLOWED_ORIGINS=
PORT=8787
REPORTS_FILE=./data/reports.jsonl
