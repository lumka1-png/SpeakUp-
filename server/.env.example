# Claude API key from https://platform.claude.com (keep it secret; never put it in the app).
# ANTHROPIC_API_KEY also works if SPEAKUP_CLAUDE_KEY is not set.
SPEAKUP_CLAUDE_KEY=
# Optional: compare quality and cost by switching models, for example claude-opus-5-5.
CLAUDE_MODEL=claude-haiku-5-5
# OpenAI API key for natural podcast voices (https://platform.openai.com). Optional: without it,
# the podcast is read by the phone's own voices. OPENAI_API_KEY also works.
SPEAKUP_OPENAI_KEY=
# Optional: change the podcast voices (OpenAI voice names).
# SPEAKUP_VOICE_MIA=marin
# SPEAKUP_VOICE_LEO=cedar
# Where podcast audio clips are saved.
AUDIO_DIR=./data/audio
# Token for the /admin/reports.csv download. Use a long random string.
ADMIN_TOKEN=
# Comma-separated web origins allowed to call the API (for the web app). Empty allows all.
ALLOWED_ORIGINS=
PORT=8787
REPORTS_FILE=./data/reports.jsonl
